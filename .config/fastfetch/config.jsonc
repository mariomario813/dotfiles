{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "padding": {
    "top": 1
  },
  "logo": {
    "type": "small",
    "padding": {
      "top": 1
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "custom",
      "format": "───────────────"
    },
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "memory",
    "break"
  ]
}
